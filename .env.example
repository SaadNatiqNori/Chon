# Firebase web config for Chon.
#
# Copy this file to `.env` and paste the values from the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration.
#
# These are not secrets. A Firebase web config is meant to ship in the browser
# bundle, and every visitor can read it. What keeps the data safe is
# firestore.rules, not the obscurity of these keys.
#
# Vite only exposes variables that begin with VITE_, so the prefix is required.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Needed for Google Analytics. Looks like G-XXXXXXXXXX. Without it the app
# still counts visitors and likes, it just reports nothing to the console.
VITE_FIREBASE_MEASUREMENT_ID=

# Set to 1 to talk to the local Firebase emulators instead of the real project:
#   npx firebase emulators:start --project demo-chon --only firestore,auth
VITE_FIREBASE_EMULATOR=
